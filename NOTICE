                              (alg:none, weak HMAC secrets, claim hygiene)
  skill_loader.py          <- on-demand vuln skill pack loader
  skills/web/*/SKILL.md    <- focused SSRF/SQLi/SSTI/LFI/IDOR/XXE/upload/deser packs

